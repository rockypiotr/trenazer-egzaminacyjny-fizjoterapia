{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "trainer": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "outputPath": "dist/trainer",
            "assets": [
              {
                "glob": "**/*",
                "input": "data",
                "output": "data"
              },
              {
                "glob": "**/*",
                "input": "images",
                "output": "images"
              }
            ],
            "styles": [
              "css/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "baseHref": "/trenazer-egzaminacyjny-fizjoterapia/",
              "optimization": {
                "fonts": false
              },
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "400kB",
                  "maximumError": "600kB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            },
            "e2e": {
              "outputPath": {
                "base": "dist/e2e/trenazer-egzaminacyjny-fizjoterapia",
                "browser": ""
              }
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "trainer:build:development"
          }
        }
      }
    }
  }
}
